#!/bin/sh
# OneCloud system optimization - ZRAM, NTP, system settings

# === Clean up fstab (remove auto-generated boot/rootfs mount entries) ===
# These entries are generated by block detection but are not needed:
# - boot partition (mmcblk1p1) is FAT16, should not be auto-mounted
# - rootfs is already mounted at boot
# Removing them avoids exFAT driver probing errors on FAT16 boot partition.
if uci show fstab >/dev/null 2>&1; then
    # Remove all mount sections that target boot partition or rootfs
    uci show fstab | grep -E 'mount.*target=.(/mnt/mmcblk|/)' | while read line; do
        section=$(echo "$line" | cut -d. -f1-2)
        uci delete "$section" 2>/dev/null
    done
    # Disable auto mount for internal eMMC partitions
    uci set fstab.@global[0].auto_mount='0'
    uci set fstab.@global[0].anon_mount='0'
    uci commit fstab
fi

# === ZRAM configuration ===
# ImmortalWrt /etc/init.d/zram reads from system section, not /etc/config/zram:
#   zram_size_mb: size in MB (default: ram_size/2048)
#   zram_comp_algo: compression algorithm (default: lzo)
uci set system.@system[0].zram_size_mb='256'
uci set system.@system[0].zram_comp_algo='lz4'

# === NTP configuration (China servers) ===
uci set system.ntp.enabled='1'
uci set system.ntp.enable_server='0'
uci delete system.ntp.server 2>/dev/null
uci add_list system.ntp.server='ntp.aliyun.com'
uci add_list system.ntp.server='time1.cloud.tencent.com'
uci add_list system.ntp.server='time.ustc.edu.cn'
uci add_list system.ntp.server='cn.pool.ntp.org'

# === System settings ===
uci set system.@system[0].hostname='OneCloud'
uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'
uci set system.@system[0].ttylogin='0'
uci set system.@system[0].log_size='4096'
uci set system.@system[0].conloglevel='1'
uci set system.@system[0].cronloglevel='9'

# === Enable irqbalance with dynamic banirq ===
# irqbalance dynamically rebalances interrupts across CPUs for better performance.
# We patch /etc/init.d/irqbalance at first boot to dynamically detect eth0/eMMC
# IRQ numbers (which can change between boots) and add them to the banirq list.
# This avoids file conflicts with the irqbalance package during build.
if [ -f /etc/config/irqbalance ]; then
    uci set irqbalance.irqbalance.enabled='1'
    uci commit irqbalance
fi

# Patch irqbalance init script to add dynamic banirq detection (only once)
# Uses awk to avoid sed quoting issues with $1 in awk commands
if [ -f /etc/init.d/irqbalance ] && ! grep -q "DYNAMIC_BANIRQ_PATCHED" /etc/init.d/irqbalance; then
    awk '
    /config_list_foreach irqbalance banirq handle_banirq_value/ {
        print $0
        print "\t# DYNAMIC_BANIRQ_PATCHED: add dynamically detected IRQs (eth0 and eMMC)"
        print "\tlocal eth0_irq emmc_irq"
        print "\teth0_irq=$(grep -E \" eth0$\" /proc/interrupts 2>/dev/null | cut -d: -f1 | tr -d \" \")"
        print "\temmc_irq=$(grep -E \" c1108e00\\.mmc$\" /proc/interrupts 2>/dev/null | cut -d: -f1 | tr -d \" \")"
        print "\t[ -n \"$eth0_irq\" ] && procd_append_param command \"-i $eth0_irq\""
        print "\t[ -n \"$emmc_irq\" ] && procd_append_param command \"-i $emmc_irq\""
        next
    }
    /procd_close_instance/ {
        print $0
        print "\tlogger -t irqbalance \"Dynamic banirq: eth0=$eth0_irq, eMMC=$emmc_irq\""
        next
    }
    { print $0 }
    ' /etc/init.d/irqbalance > /etc/init.d/irqbalance.new
    mv /etc/init.d/irqbalance.new /etc/init.d/irqbalance
    chmod 755 /etc/init.d/irqbalance
    logger -t system-optimize "Patched /etc/init.d/irqbalance with dynamic banirq detection"
fi

# === Set default LuCI theme to Argon and language to Chinese ===
if [ -f /etc/config/luci ]; then
    uci set luci.main.mediaurlbase='/luci-static/argon'
    uci set luci.main.lang='zh_cn'
    uci commit luci
fi

# === ttyd: auto-login root without password, bind to LAN ===
if [ -f /etc/config/ttyd ]; then
    uci set ttyd.@ttyd[0].command='/bin/login -f root'
    uci set ttyd.@ttyd[0].interface='br-lan'
    uci commit ttyd
fi

# === fstab: disable anonymous auto-mount ===
# The boot partition (mmcblk1p1) must not be auto-mounted during normal
# operation; doing so causes "Volume was not properly unmounted" warnings
# and can interfere with sysupgrade writes to the boot partition.
if [ -f /etc/config/fstab ]; then
    uci set fstab.@global[0].anon_mount='0'
    uci set fstab.@global[0].auto_mount='0'
    uci commit fstab
fi

uci commit system

exit 0
