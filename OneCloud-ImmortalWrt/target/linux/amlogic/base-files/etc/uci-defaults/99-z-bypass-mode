#!/bin/sh
# OneCloud bypass router: LAN=192.168.2.2/24, gateway=192.168.2.1, DHCP off

# uhttpd/rpcd timeouts (for LuCI firmware upload)
uci set uhttpd.main.script_timeout='300'
uci set uhttpd.main.network_timeout='60'
uci set uhttpd.main.http_keepalive='60'
uci set rpcd.@rpcd[0].timeout='300'
uci commit uhttpd
uci commit rpcd

# Memory: swappiness=10, cache_pressure=50 (idempotent, no duplicate entries)
grep -q "vm.swappiness" /etc/sysctl.conf || cat >> /etc/sysctl.conf << 'EOF'
vm.swappiness=10
vm.vfs_cache_pressure=50
EOF
sysctl -p /etc/sysctl.conf 2>/dev/null

# Static IP
uci set network.lan.proto='static'
uci delete network.lan.ipaddr 2>/dev/null
uci add_list network.lan.ipaddr='192.168.2.2/24'
uci set network.lan.gateway='192.168.2.1'
uci delete network.lan.dns 2>/dev/null
uci add_list network.lan.dns='192.168.2.1'
uci delete network.lan.ip6assign 2>/dev/null

# Disable DHCP + IPv6 RA (proxy has IPv6 disabled)
uci set dhcp.lan.ignore='1'
uci set dhcp.lan.ra='disabled'
uci set dhcp.lan.dhcpv6='disabled'

# DNS: explicitly disable redirection, use gateway as upstream
uci set dhcp.@dnsmasq[0].dns_redirect='0'
uci set dhcp.@dnsmasq[0].noresolv='1'
uci set dhcp.@dnsmasq[0].localuse='1'
uci set dhcp.@dnsmasq[0].nonwildcard='1'
uci set dhcp.@dnsmasq[0].bind_dynamic='1'
uci set dhcp.@dnsmasq[0].authoritative='0'
uci set dhcp.@dnsmasq[0].rebind_protection='0'
uci set dhcp.@dnsmasq[0].rebind_localhost='0'
uci delete dhcp.@dnsmasq[0].server 2>/dev/null
uci add_list dhcp.@dnsmasq[0].server='192.168.2.1'

# DNS cache: 10min min TTL, stale-cache fallback, filter AAAA (IPv6 proxy disabled)
uci set dhcp.@dnsmasq[0].min_cache_ttl='600'
uci set dhcp.@dnsmasq[0].use_stale_cache='3600'
uci set dhcp.@dnsmasq[0].nonegcache='1'
uci set dhcp.@dnsmasq[0].cachesize='8000'
uci set dhcp.@dnsmasq[0].filter_aaaa='1'

# Firewall: accept forwarding, NAT masquerade on LAN (required for transparent proxy)
uci set firewall.@defaults[0].forward='ACCEPT'
# Bypass router with transparent proxy: LAN masquerade MUST be enabled.
# Clients send to gateway=.2.2, Nikki proxies and forwards to .2.1; without NAT
# the source IP stays as the client and .2.1 replies directly, bypassing conntrack
# on .2.2 — connections get stuck in SYN_SENT [UNREPLIED]. Masquerading rewrites
# source to .2.2 so return traffic comes back through the proxy.
uci set firewall.@zone[0].masq='1'
uci set firewall.@zone[0].mtu_fix='1'
# Flow offloading MUST be disabled: it bypasses conntrack on the forward path and
# breaks transparent proxy return-path handling.
uci set firewall.@defaults[0].flow_offloading='0'
uci set firewall.@defaults[0].flow_offloading_hw='0'
uci set firewall.@defaults[0].fullcone='0'
uci set firewall.@defaults[0].fullcone6='0'
uci set firewall.@defaults[0].syn_flood='0'
# drop_invalid MUST be disabled on single-NIC bypass routers: hairpin NAT
# (packet enters br-lan and exits br-lan) causes some TCP SYN-ACK packets
# to be tagged ct state invalid by conntrack, and the "Prevent NAT leakage"
# rule drops them — connections get stuck in SYN_RECV forever.
uci set firewall.@defaults[0].drop_invalid='0'
uci delete firewall.dns_redirect 2>/dev/null
uci delete firewall.dns_redirect6 2>/dev/null

# System
uci set system.@system[0].hostname='OneCloud'
uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'

# NTP (China)
uci set system.ntp.enabled='1'
uci delete system.ntp.server 2>/dev/null
uci add_list system.ntp.server='ntp.aliyun.com'
uci add_list system.ntp.server='time1.cloud.tencent.com'
uci add_list system.ntp.server='cn.pool.ntp.org'

# ZRam: 256MB lz4
uci set system.@system[0].zram_size_mb='256'
uci set system.@system[0].zram_comp_algo='lz4'

# Disable auto-mount (only p3 data mounted via fstab)
uci set fstab.@global[0].auto_mount='0'
uci set fstab.@global[0].anon_mount='0'

# ttyd: auto login as root
uci set ttyd.@ttyd[0].command='/bin/login -f root'

uci commit network
uci commit dhcp
uci commit firewall
uci commit system
uci commit fstab
uci commit ttyd

# Disable unnecessary services
[ -x /etc/init.d/odhcpd ] && /etc/init.d/odhcpd disable 2>/dev/null

# Ensure cron can start: init script exits 1 when /etc/crontabs/ is empty
mkdir -p /etc/crontabs
[ -f /etc/crontabs/root ] || touch /etc/crontabs/root
chmod 600 /etc/crontabs/root
[ -x /etc/init.d/cron ] && /etc/init.d/cron enable 2>/dev/null

# irqbalance: spread NIC IRQs across 4 cores (eth0 IRQ was pinned to CPU0)
[ -x /etc/init.d/irqbalance ] && /etc/init.d/irqbalance enable 2>/dev/null && /etc/init.d/irqbalance start 2>/dev/null

# zram-swap: 256MB compressed swap (LZ4) on 1GB RAM device
if uci -q get zram-swap.@zram-swap[0] > /dev/null 2>&1; then
	uci set zram-swap.@zram-swap[0].size='256'
	uci set zram-swap.@zram-swap[0].comp_algo='lz4'
	uci commit zram-swap
	[ -x /etc/init.d/zram-swap ] && /etc/init.d/zram-swap enable 2>/dev/null
fi

# Nikki: do not preset start_delay — boot() runs in background and a long
# sleep can cause the deferred start to be lost, resulting in no auto-start.
# GeoIP download retry is handled by mihomo itself.

# Nikki: hourly log rotation / 5MB limit
if uci -q get nikki.log > /dev/null 2>&1; then
	uci set nikki.log.scheduled_clear_cron='0 * * * *'
	uci set nikki.log.scheduled_clear_size_limit='5'
	uci commit nikki
fi

exit 0
