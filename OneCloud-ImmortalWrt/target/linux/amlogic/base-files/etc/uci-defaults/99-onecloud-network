#!/bin/sh
# OneCloud bypass router network setup
# Runs on first boot, sets static IP and disables DHCP server

# Set LAN interface to static IP (CIDR format)
uci set network.lan.proto='static'
uci delete network.lan.ipaddr 2>/dev/null
uci add_list network.lan.ipaddr='192.168.2.2/24'
uci set network.lan.gateway='192.168.2.1'
uci delete network.lan.dns 2>/dev/null
uci add_list network.lan.dns='192.168.2.1'
# Bypass router: disable IPv6 prefix delegation to avoid conflict with main router
uci delete network.lan.ip6assign 2>/dev/null
uci set network.lan.multipath='off'

# Set br-lan MAC address derived from eMMC CID (same algorithm as 10-fix-mac).
# We compute it directly from CID instead of reading eth0's MAC, because
# 10-fix-mac runs via hotplug and may execute after this uci-defaults script
# (race condition: reading eth0 early would get the random driver-generated MAC).
# Retry briefly because eMMC may not be registered yet when uci-defaults runs.
(
    for i in 1 2 3 4 5; do
        # Find eMMC device and read its CID
        CID=""
        for dev in mmcblk1 mmcblk0; do
            if [ -f "/sys/block/$dev/device/cid" ]; then
                mtype=$(cat "/sys/block/$dev/device/type" 2>/dev/null)
                if [ "$mtype" = "MMC" ]; then
                    CID=$(cat "/sys/block/$dev/device/cid" 2>/dev/null)
                    [ -n "$CID" ] && break
                fi
            fi
        done

        if [ -n "$CID" ]; then
            # Derive locally-administered unicast MAC from CID bytes 1-5
            B1=$(echo "$CID" | cut -c3-4)
            B2=$(echo "$CID" | cut -c5-6)
            B3=$(echo "$CID" | cut -c7-8)
            B4=$(echo "$CID" | cut -c9-10)
            B5=$(echo "$CID" | cut -c11-12)
            if [ -n "$B1" ] && [ -n "$B2" ] && [ -n "$B3" ] && [ -n "$B4" ] && [ -n "$B5" ]; then
                ETH0_MAC="02:${B1}:${B2}:${B3}:${B4}:${B5}"
                # Find the bridge device section by name, not by index
                local found=0
                local idx=0
                while uci -q get network.@device[$idx].name >/dev/null 2>&1; do
                    local name=$(uci -q get network.@device[$idx].name)
                    if [ "$name" = "br-lan" ]; then
                        uci set network.@device[$idx].macaddr="$ETH0_MAC"
                        found=1
                        break
                    fi
                    idx=$((idx + 1))
                done
                # If no br-lan device section exists, create one
                if [ "$found" = "0" ]; then
                    uci add network device >/dev/null 2>&1
                    uci set network.@device[-1].name='br-lan'
                    uci set network.@device[-1].type='bridge'
                    uci set network.@device[-1].ports='eth0'
                    uci set network.@device[-1].macaddr="$ETH0_MAC"
                fi
                uci commit network
                logger -t network-setup "br-lan MAC set to $ETH0_MAC (derived from eMMC CID)"
                break
            fi
        fi
        sleep 1
    done
) &

# Disable DHCP server on LAN (bypass router mode)
uci set dhcp.lan.ignore='1'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ra='disabled'

# dnsmasq: bypass router optimizations
# - DNS redirection disabled (Nikki handles DNS hijacking on port 53 -> 1053)
# - No DNS forwarders (upstream DNS comes from resolvfile = main router)
# - authoritative off (not serving DHCP)
# - rebind protection off (not needed in bypass mode)
# - nonwildcard to avoid binding to dynamic interfaces (e.g. TUN)
uci delete dhcp.@dnsmasq[0].dns_redir 2>/dev/null
uci delete dhcp.@dnsmasq[0].server 2>/dev/null
uci set dhcp.@dnsmasq[0].authoritative='0'
uci set dhcp.@dnsmasq[0].rebind_protection='0'
uci set dhcp.@dnsmasq[0].rebind_localhost='0'
uci set dhcp.@dnsmasq[0].nonwildcard='1'
uci set dhcp.@dnsmasq[0].resolvfile='/tmp/resolv.conf.d/resolv.conf.auto'
uci set dhcp.@dnsmasq[0].localservice='1'

# Firewall: bypass mode (single arm)
uci set firewall.@defaults[0].forward='ACCEPT'
uci set firewall.@defaults[0].flow_offloading='1'
uci set firewall.@defaults[0].flow_offloading_hw='0'
uci set firewall.@defaults[0].syn_flood='0'
# fullcone NAT requires kmod-nft-fullcone; only set if available
if uci -q get firewall.@defaults[0].fullcone >/dev/null 2>&1; then
    uci set firewall.@defaults[0].fullcone='1'
    uci set firewall.@defaults[0].fullcone6='1'
fi

uci commit network
uci commit dhcp
uci commit firewall

# RPS/RFS/XPS is applied by /etc/hotplug.d/net/20-rps-rfs on interface
# registration/up. However, on this platform:
#   1. eth0 registers very early (hotplug event may be missed)
#   2. netifd RESETS RPS (but not XPS) when it configures the bridge
# So we apply RPS in a delayed background loop after netifd finishes.
# NOTE: The RPS script only sets sysfs parameters (RPS/XPS/BQL/GRO) — ethtool
# commands and IRQ affinity changes were removed because they can cause kernel
# panics or watchdog resets on this platform. This delayed trigger is safe.
(
    # Wait for netifd to finish configuring interfaces (it resets RPS)
    sleep 15
    # Retry a few times in case network is still being configured
    for retry in 1 2 3 4 5; do
        for iface in eth0 br-lan; do
            if [ -d "/sys/class/net/$iface" ]; then
                ACTION=add INTERFACE="$iface" /etc/hotplug.d/net/20-rps-rfs 2>/dev/null
            fi
        done
        sleep 5
    done
    logger -t network-setup "RPS/XPS applied after netifd configuration"
) &

# IRQ affinity for eth0/eMMC is protected by dynamic irqbalance banirq (detected
# at boot via patched /etc/init.d/irqbalance), so irqbalance won't override
# kernel-default affinity for these critical devices.

exit 0
