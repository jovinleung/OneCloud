# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

# /tmp use 80% RAM
mount -o remount,size=80% /tmp

# Load GPIO button hotplug module
modprobe gpio_button_hotplug 2>/dev/null

# --- Storage performance tuning ---
# eMMC: larger read-ahead for sequential reads (NAS workload), use "none" scheduler (eMMC has FTL)
for blk in /sys/block/mmcblk*; do
	[ -d "$blk" ] || continue
	# Only tune MMC devices (not SD cards unless desired)
	type=$(cat "$blk/device/type" 2>/dev/null)
	[ "$type" = "MMC" ] || continue
	echo 2048 > "$blk/queue/read_ahead_kb" 2>/dev/null
	echo 1024 > "$blk/queue/nr_requests" 2>/dev/null
	echo none > "$blk/queue/scheduler" 2>/dev/null
done

# --- Network performance tuning ---
# Increase NIC ring buffers to max (1024) to reduce drops under bursty load
# Enable offloads (GRO/GSO/TSO) to reduce CPU overhead on forwarding
if command -v ethtool >/dev/null 2>&1; then
	ethtool -G eth0 rx 1024 tx 1024 >/dev/null 2>&1
	ethtool -K eth0 gro on gso on tso on rx on tx on >/dev/null 2>&1
fi

# RPS/XPS: managed by the packet_steering service (enabled via uci-defaults
# 97-enable-packet-steering, packet_steering=2). Do NOT hard-pin here — the
# procd-managed service re-applies after the meson8b-dwmac interface
# re-initializes during boot; a one-shot rc.local write can be lost.

# IRQ affinity: managed by irqbalance (enabled in uci-defaults).

exit 0
