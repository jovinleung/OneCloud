From: hzy <hzyitc@outlook.com>
Subject: [PATCH] pwm: meson: handle edge cases in .get_state

When the low counter is zero the period is determined by the high
counter alone and the duty cycle is 100%; when low >= hi the normal
formula applies.  Guard the remaining (invalid) case instead of
reporting a bogus period/duty_cycle.

--- a/drivers/pwm/pwm-meson.c
+++ b/drivers/pwm/pwm-meson.c
@@ -360,8 +360,16 @@ static int meson_pwm_get_state(struct pwm_chip *chip,
 	lo = FIELD_GET(PWM_LOW_MASK, value);
 	hi = FIELD_GET(PWM_HIGH_MASK, value);
 
-	state->period = meson_pwm_cnt_to_ns(fin_freq, lo + hi);
-	state->duty_cycle = meson_pwm_cnt_to_ns(fin_freq, hi);
+	if (lo == 0) {
+		state->period = meson_pwm_cnt_to_ns(fin_freq, hi);
+		state->duty_cycle = state->period;
+	} else if (lo >= hi) {
+		state->period = meson_pwm_cnt_to_ns(fin_freq, lo + hi);
+		state->duty_cycle = meson_pwm_cnt_to_ns(fin_freq, hi);
+	} else {
+		state->period = 0;
+		state->duty_cycle = 0;
+	}
 
 	return 0;
 }
