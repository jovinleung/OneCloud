# ============================================================
# OneCloud (Amlogic S805) ImmortalWrt 优化配置
# 用途：旁路由 + mihomo 透明代理 + 网络共享盘（Samba/USB存储）
# 使用方式：作为 .config 放入源码根目录，执行 make defconfig 自动补全
# ============================================================

# ---------- 目标平台（amlogic/meson8b，玩客云 S805） ----------
CONFIG_TARGET_amlogic=y
CONFIG_TARGET_amlogic_meson8b=y
CONFIG_TARGET_amlogic_meson8b_DEVICE_thunder-onecloud=y
CONFIG_TARGET_DEVICE_PACKAGES_amlogic_meson8b_DEVICE_thunder-onecloud=""

# ---------- 镜像分区 ----------
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=512
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_EXT4_RESERVED_PCT=1

# ---------- 编译优化 ----------
# Cortex-A5 具备硬件 VFPv4+NEON，严禁启用 SOFT_FLOAT（会导致性能暴跌）
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -march=cortex-a5 -mtune=cortex-a5 -mfpu=neon-vfpv4"
CONFIG_AUTOREMOVE=y

# ---------- 内核网络优化（模块包） ----------
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-sched-fq=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-tun=y

# ---------- 网络加速 ----------
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
CONFIG_PACKAGE_shortcut-fe=y
CONFIG_PACKAGE_kmod-fast-classifier=y
CONFIG_PACKAGE_kmod-shortcut-fe=y

# ---------- 系统工具 ----------
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_vim=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_autocore-arm=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_autosamba=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_lscpu=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_less=y
CONFIG_PACKAGE_coreutils=y
# ---------- 文件系统工具（FAT 修复 / 分区） ----------
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_parted=y
# ---------- ZRAM 虚拟内存（1GB 内存必备，LZ4 压缩） ----------
# 注：内核级 ZRAM/LZ4 配置已在 target/linux/amlogic/meson8b/config-6.18 中设定
CONFIG_PACKAGE_zram-swap=y
# ---------- OpenSSL 优化 ----------
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
CONFIG_OPENSSL_WITH_ASM=y
CONFIG_PACKAGE_libopenssl-afalg=y
CONFIG_PACKAGE_openssl-util=y

# ---------- 代理核心（只选 mihomo-meta，排除 alpha 避免递归依赖） ----------
CONFIG_PACKAGE_mihomo-meta=y
# CONFIG_PACKAGE_mihomo-alpha is not set
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y

# ---------- Docker（纯旁路由不需要，用则取消注释） ----------
# CONFIG_PACKAGE_dockerd=y
# CONFIG_PACKAGE_docker=y
# CONFIG_PACKAGE_docker-compose=y
# CONFIG_PACKAGE_luci-app-dockerman=y
# CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
# CONFIG_PACKAGE_kmod-dummy=y

# ---------- 管理界面 ----------
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y
# ttyd 网页终端（保留）
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
# uPnP（旁路由不需要，主路由负责）
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-i18n-upnp-zh-cn is not set

# ---------- 存储 / 文件共享（网络共享盘） ----------
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb2=y
# SMB 文件共享
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
# 网络发现（Windows/Mac 自动发现共享）
CONFIG_PACKAGE_avahi-daemon=y
CONFIG_PACKAGE_wsdd2=y

# ---------- 主题 ----------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ---------- 语言 ----------
CONFIG_LUCI_LANG_zh_Hans=y

# ---------- 禁用不需要的包（避免编译失败） ----------
# yq (Go 语言 YAML 工具) 不禁用，通过工作流设置 GOPROXY + GOFLAGS=-mod=mod
# 修复 make download 阶段 Go 模块 internal 子包缺失的编译问题
